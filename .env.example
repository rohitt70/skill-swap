# SkillSwap Environment Variables Configuration (Example / Template)

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://skillswap_user:skillswap_password@localhost:5432/skillswap_db?schema=public

# Redis Configuration (Optional in development, recommended in production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_token_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session & Cookie Security
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret
COOKIE_SECURE=false

# Chat Session Lifecycle Timeouts (in minutes)
CHAT_INACTIVITY_WARNING_MINUTES=5
CHAT_INACTIVITY_LOCK_MINUTES=10
CHAT_REJOIN_WINDOW_MINUTES=15
CHAT_ABSOLUTE_LIMIT_MINUTES=60

# S3 / Object Storage (Optional for profile avatars)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=skillswap-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
